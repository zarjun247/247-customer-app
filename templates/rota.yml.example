holidays_covered:
  - date: "2026-01-26"  # Republic Day
    coverage: "TBD"
  - date: "2026-03-25"  # Holi
    coverage: "TBD"
  - date: "2026-04-14"  # Ambedkar Jayanti / Dr. B.R. Ambedkar Birthday
    coverage: "TBD"

# Rules enforced by pnpm run rota:validate:
#   - Every week must have a non-TBD primary
#   - Primary and secondary must be different people
#   - weekend_primary must be specified
#   - No single person on primary for more than 14 consecutive days
#   - Holiday dates must have explicit coverage (not TBD)
