              "id": "CVE-2026-32281",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "crypto/x509: golang: Go crypto/x509: Denial of Service via inefficient certificate chain validation"
              },
              "fullDescription": {
