# ============================================================
# 247 Pharmacy OS — Environment Variables Reference
# Generated from server/_core/env.ts + server/config/providerContracts.ts
# Copy to .env and fill in values. Never commit a real .env.
# ============================================================

# ── Core (required in all environments) ─────────────────────
NODE_ENV=development
DATABASE_URL=mysql://user:password@localhost:3306/pharmacy_dev
JWT_SECRET=change-me-to-a-random-secret
# CSRF protection secret (required in production — use a strong random value ≥32 chars)
CSRF_SECRET=change-me-to-a-random-csrf-secret
# Cookie domain for session cookie scoping (required in production, e.g. .example.com)
COOKIE_DOMAIN=
VITE_APP_ID=247-pharmacy

# ── Auth / OAuth ─────────────────────────────────────────────
OAUTH_PROVIDER_ENABLED=true
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=

# ── Storage (Forge / S3-compatible) ──────────────────────────
STORAGE_PROVIDER_ENABLED=true
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=
AWS_REGION=ap-south-1

# ── Payment (Razorpay) ────────────────────────────────────────
PAYMENT_PROVIDER_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=
# Set to true only after the webhook route has been audited:
PAYMENT_WEBHOOK_ROUTE_IMPLEMENTED=false

# ── WhatsApp ──────────────────────────────────────────────────
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ── OTP ───────────────────────────────────────────────────────
OTP_PROVIDER_ENABLED=false
OTP_PROVIDER_API_KEY=
# database | memory_allowed_for_single_instance
OTP_RATE_LIMIT_BACKEND=database

# ── SMS ───────────────────────────────────────────────────────
SMS_PROVIDER_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# ── Email ─────────────────────────────────────────────────────
EMAIL_PROVIDER_ENABLED=false
EMAIL_PROVIDER_API_KEY=

# ── Push Notifications (FCM) ──────────────────────────────────
PUSH_PROVIDER_ENABLED=false
PUSH_PROVIDER_API_KEY=
FCM_PRIVATE_KEY=

# ── OCR (purchase inwarding) ──────────────────────────────────
OCR_PROVIDER_ENABLED=false
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_NAME=

# ── Maps / Geocoding ──────────────────────────────────────────
MAPS_PROVIDER_ENABLED=false
GOOGLE_MAPS_API_KEY=

# ── Telemedicine / Doctor Consult ────────────────────────────
# Doctor consult external redirect URL (Option B — no in-app scheduling)
# Set to your telemedicine partner URL. If blank, consult.getRedirectUrl returns null.
DOCTOR_CONSULT_URL=

# ── ERP (Tally) ───────────────────────────────────────────────
ERP_PROVIDER_ENABLED=false
ERP_BASE_URL=
ERP_API_KEY=
ERP_COMPANY_ID=

# ── Label Printer ─────────────────────────────────────────────
PRINTER_PROVIDER_ENABLED=false
PRINTER_HOST=
PRINTER_PORT=9100

# ── Workers ───────────────────────────────────────────────────
WORKER_CRON_SECRET=
WORKER_ADMIN_TOKEN=
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
RETENTION_WORKER_ENABLED=false
DSR_SLA_MONITOR_ENABLED=false

# ── Reservations / Stock lock ─────────────────────────────────
RESERVATION_TTL_SECONDS=900
RESERVATION_EXPIRY_WORKER_ENABLED=true
RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=30000
RESERVATION_EXPIRY_BATCH_SIZE=100
STOCK_LOCK_CLEANUP_ENABLED=true
STOCK_LOCK_CLEANUP_INTERVAL_MS=60000
STOCK_LOCK_TIMEOUT_MS=5000

# ── Security / DPDP ───────────────────────────────────────────
# Required in production. Must be a base64-encoded 32-byte key.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_MASTER_KEY=
VAULT_ENCRYPTION_KEY_VERSION=1
# off | report_only | enforce
CSP_MODE=enforce
CSP_REPORT_URI=
AUDIT_CHAIN_VERIFY_ON_STARTUP=false
# off | log_only | enforce
DPDP_ENFORCEMENT_MODE=enforce
DPDP_REGION_REQUIRED=
# off | log_only | enforce
CSRF_ENFORCEMENT=log_only
CSRF_TOKEN_TTL_HOURS=24
# off | log_only | enforce
STORE_SCOPE_ENFORCEMENT_MODE=enforce
# memory | redis
API_RATE_LIMIT_BACKEND=memory
DPO_EMAIL=dpo@example.com
BREACH_NOTIFY_RECIPIENT_EMAIL=

# ── Error Monitoring (Sentry) ────────────────────────────────
# Required for production error capture. Install @sentry/node first.
# See server/_core/errorMonitoring.ts for activation instructions.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# ── Session Security ──────────────────────────────────────────
# Session TTL in days (default 30, max 90)
SESSION_TTL_DAYS=30

# ── Observability (OTel) ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=247-customer-app
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
METRICS_SCRAPE_TOKEN=

# ── On-call ───────────────────────────────────────────────────
ONCALL_PAGERDUTY_INTEGRATION_KEY=
ONCALL_ALERT_EMAIL=

# ── Intelligence / Eval ledger ────────────────────────────────
AI_EVAL_LEDGER_ENABLED=true
REFILL_RISK_LOOKBACK_DAYS=180
STOCKOUT_LOOKAHEAD_DAYS=30
CONTINUITY_GRAPH_MAX_NODES=500

# ── Deployment / Release ──────────────────────────────────────
# pilot | scaled | full
APP_PHASE=pilot
# staging | production
RELEASE_CHANNEL=staging
DOCKER_REGISTRY=
# cyclonedx | spdx
SBOM_FORMAT=cyclonedx
STAGING_DEPLOY_DRY_RUN=true
BACKUP_DRILL_ENABLED=false
BACKUP_DRILL_MIN_INTERVAL_HOURS=168
INCIDENT_DRILL_CRON=

# ── Chaos / Validation ────────────────────────────────────────
CHAOS_DRILL_ENABLED=false
DEPLOYMENT_VALIDATION_REQUIRED=false

# ── Analytics (Umami, optional) ───────────────────────────────
# When set, the umami analytics script is injected into the built HTML.
# Leave empty to disable analytics (no script loaded).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
